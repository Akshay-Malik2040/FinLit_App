{
  "name": "finlit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && npm run backend:build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backend:dev": "tsx watch backend/src/server.ts",
